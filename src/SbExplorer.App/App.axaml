<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SbExplorer.App.App"
             Name="Service Bus Explorer"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <FontFamily x:Key="MonoFont">Menlo, Consolas, DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#D13438" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.success">
      <Setter Property="Foreground" Value="#2EA043" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#C42B1C" />
    </Style>
    <Style Selector="Border.glyph">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.glyph > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.badge.danger">
      <Setter Property="Background" Value="#33D13438" />
    </Style>
    <Style Selector="Border.badge.danger > TextBlock">
      <Setter Property="Foreground" Value="#D13438" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="ListBox.segmented">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
    <Style Selector="Button.danger-outline">
      <Setter Property="Foreground" Value="#D13438" />
      <Setter Property="BorderBrush" Value="#D13438" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.notice">
      <Setter Property="Background" Value="#22FFB900" />
      <Setter Property="BorderBrush" Value="#66FFB900" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.locked">
      <Setter Property="Background" Value="#220078D4" />
      <Setter Property="BorderBrush" Value="#660078D4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
  </Application.Styles>
</Application>
