<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SbExplorer.App.App"
             Name="Service Bus Explorer"
             RequestedThemeVariant="Light">
  <!-- Colors and layout follow the original Windows Service Bus Explorer. -->
  <Application.Resources>
    <FontFamily x:Key="MonoFont">Courier New, Menlo, Consolas, DejaVu Sans Mono, monospace</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI, Tahoma, Helvetica Neue, Arial, DejaVu Sans, sans-serif</FontFamily>

    <SolidColorBrush x:Key="WindowBrush" Color="#D7E4F2" />
    <SolidColorBrush x:Key="GroupBrush" Color="#99B4D1" />
    <SolidColorBrush x:Key="ContentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
    <LinearGradientBrush x:Key="PanelHeaderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#BCCBDA" />
      <GradientStop Offset="0.5" Color="#ADC2D7" />
      <GradientStop Offset="1" Color="#9FB8D3" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#FBFCFE" />
      <GradientStop Offset="1" Color="#DCE6F2" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonHoverBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#FFFFFF" />
      <GradientStop Offset="1" Color="#C9DCF2" />
    </LinearGradientBrush>

    <!-- Entity icons, drawn so they work at any scale. -->
    <DrawingImage x:Key="NamespaceIcon">
      <DrawingGroup>
        <GeometryDrawing Brush="#2F7FD8" Geometry="M8,0.5 A7.5,7.5 0 1 1 7.99,0.5 Z">
          <GeometryDrawing.Pen><Pen Brush="#1D5FAE" Thickness="0.8" /></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M8,0.8 C4.5,4 4.5,12 8,15.2 M8,0.8 C11.5,4 11.5,12 8,15.2 M1,8 L15,8 M2.2,4.4 L13.8,4.4 M2.2,11.6 L13.8,11.6">
          <GeometryDrawing.Pen><Pen Brush="#DDEBFA" Thickness="0.9" /></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage>
    <DrawingImage x:Key="QueueIcon">
      <DrawingGroup>
        <GeometryDrawing Brush="#2B67C6" Geometry="M3,3 L13,3 L13,13 C13,14.8 3,14.8 3,13 Z">
          <GeometryDrawing.Pen><Pen Brush="#174A97" Thickness="0.7" /></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#9CC3F5" Geometry="M3,3 C3,1.2 13,1.2 13,3 C13,4.8 3,4.8 3,3 Z">
          <GeometryDrawing.Pen><Pen Brush="#174A97" Thickness="0.7" /></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M3,7.3 C3,8.8 13,8.8 13,7.3 M3,10.4 C3,11.9 13,11.9 13,10.4">
          <GeometryDrawing.Pen><Pen Brush="#DDEBFA" Thickness="0.9" /></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage>
    <DrawingImage x:Key="TopicIcon">
      <DrawingGroup>
        <GeometryDrawing Brush="#3B9E4A" Geometry="M8,1 L12.5,8 L3.5,8 Z">
          <GeometryDrawing.Pen><Pen Brush="#256B30" Thickness="0.7" /></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#2B67C6" Geometry="M4,8 L8,15 L0.3,15 Z">
          <GeometryDrawing.Pen><Pen Brush="#174A97" Thickness="0.7" /></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#2B67C6" Geometry="M12,8 L15.7,15 L8,15 Z">
          <GeometryDrawing.Pen><Pen Brush="#174A97" Thickness="0.7" /></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage>
    <DrawingImage x:Key="SubscriptionIcon">
      <DrawingGroup>
        <GeometryDrawing Brush="#F4C542" Geometry="M1,3.5 L15,3.5 L15,12.5 L1,12.5 Z">
          <GeometryDrawing.Pen><Pen Brush="#A87A0C" Thickness="0.8" /></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M1.3,3.8 L8,9 L14.7,3.8">
          <GeometryDrawing.Pen><Pen Brush="#A87A0C" Thickness="0.9" /></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage>
    <DrawingImage x:Key="RuleIcon">
      <DrawingGroup>
        <GeometryDrawing Brush="#8C6BD6" Geometry="M1,2 L15,2 L9.5,8.5 L9.5,14 L6.5,12.5 L6.5,8.5 Z">
          <GeometryDrawing.Pen><Pen Brush="#5B3FA6" Thickness="0.8" /></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage>
    <DrawingImage x:Key="DisabledOverlayIcon">
      <DrawingGroup>
        <GeometryDrawing Brush="#C42B1C" Geometry="M8,0.5 A7.5,7.5 0 1 1 7.99,0.5 Z" />
        <GeometryDrawing Geometry="M4,8 L12,8">
          <GeometryDrawing.Pen><Pen Brush="White" Thickness="2.2" /></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource WindowBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Panel with the gradient header strip ("Service Bus Namespace", "View Queue: …", "Log"). -->
    <Style Selector="HeaderedContentControl.panel">
      <Setter Property="Background" Value="{StaticResource WindowBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border BorderBrush="{StaticResource GroupBrush}" BorderThickness="1" Background="{TemplateBinding Background}">
            <DockPanel>
              <Border DockPanel.Dock="Top" Height="24" Background="{StaticResource PanelHeaderBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,0">
                  <Image Source="{StaticResource NamespaceIcon}" Width="15" Height="15" VerticalAlignment="Center" />
                  <ContentPresenter Content="{TemplateBinding Header}" Foreground="White" FontWeight="Bold"
                                    FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Group box with a caption tab on its top edge, like the original's grouper. -->
    <Style Selector="HeaderedContentControl.group">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Border Margin="0,10,0,0" Padding="10,18,10,8" CornerRadius="4"
                    BorderBrush="{StaticResource GroupBrush}" BorderThickness="1">
              <ContentPresenter Content="{TemplateBinding Content}" />
            </Border>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,0,0,0" Padding="10,2"
                    CornerRadius="3" Background="{StaticResource GroupBrush}">
              <ContentPresenter Content="{TemplateBinding Header}" Foreground="White" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
      <Setter Property="BorderBrush" Value="#8EA9C9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="MinWidth" Value="75" />
      <Setter Property="MinHeight" Value="23" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}" />
      <Setter Property="BorderBrush" Value="#3C7FB1" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="6,1" />
    </Style>

    <Style Selector="TextBox, NumericUpDown, ComboBox">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#7A9CC6" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style Selector="TabControl">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Background" Value="#E8EFF8" />
      <Setter Property="BorderBrush" Value="{StaticResource GroupBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="White" />
    </Style>
    <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Menu">
      <Setter Property="Background" Value="{StaticResource WindowBrush}" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="2,0" />
    </Style>

    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.success">
      <Setter Property="Foreground" Value="#2E7D32" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Margin" Value="0,4,0,1" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#C42B1C" />
    </Style>
    <Style Selector="Button.danger-outline">
      <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    </Style>
    <Style Selector="Border.notice">
      <Setter Property="Background" Value="#FFF4CE" />
      <Setter Property="BorderBrush" Value="#E0C36A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.locked">
      <Setter Property="Background" Value="#E3EEFB" />
      <Setter Property="BorderBrush" Value="{StaticResource GroupBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.white">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#7A9CC6" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBox.segmented">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </Application.Styles>
</Application>
