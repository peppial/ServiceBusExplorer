<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SbExplorer.App.ViewModels"
             xmlns:mgmt="using:SbExplorer.Core.Management"
             xmlns:views="using:SbExplorer.App.Views"
             x:Class="SbExplorer.App.Views.ExplorerView"
             x:DataType="vm:ExplorerViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="LoadStatusText" Text="{Binding LoadStatus}" FontSize="12" Opacity="0.7"
                   Classes.error="{Binding HasError}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Content="Cancel" Command="{Binding RefreshCancelCommand}"
                IsVisible="{Binding RefreshCommand.IsRunning}" />
        <Button x:Name="RefreshButton" Content="⟳ Refresh" Command="{Binding RefreshCommand}"
                ToolTip.Tip="Refresh (F5)" />
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="340,4,*">
      <DockPanel Grid.Column="0">
        <Border DockPanel.Dock="Top" Classes="notice" IsVisible="{Binding IsLimited}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding LimitedNotice}" TextWrapping="Wrap" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="+ Add entity…" Command="{Binding AddEntityCommand}" />
              <Button Content="Remove" Command="{Binding RemoveEntityCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,6"
                 Text="{Binding Filter}" PlaceholderText="Filter by name" />
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" MinHeight="2"
                     IsVisible="{Binding RefreshCommand.IsRunning}" />
        <TreeView x:Name="EntityTree" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode}">
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="IsVisible" Value="{Binding IsVisible}" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="6" Opacity="{Binding IsDimmed, Converter={x:Static vm:Converters.DimmedOpacity}}">
                <Border Classes="glyph" IsVisible="{Binding Glyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding Glyph}" />
                </Border>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <Border Classes="badge" IsVisible="{Binding ActiveBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding ActiveBadge}" />
                </Border>
                <Border Classes="badge danger" IsVisible="{Binding HasDeadLetters}">
                  <TextBlock Text="{Binding DeadLetterBadge}" />
                </Border>
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

      <Panel Grid.Column="2" Margin="12,0,0,0">
        <TextBlock Text="Select a queue, topic, subscription or rule." Opacity="0.6"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !HasSelection}" />
        <DockPanel IsVisible="{Binding HasSelection}">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock x:Name="SelectedName" Text="{Binding SelectedEntity.Name, FallbackValue=''}"
                       FontSize="20" FontWeight="SemiBold" />
            <SelectableTextBlock Text="{Binding SelectedEntity.Path, FallbackValue=''}" FontSize="12" Opacity="0.7" />
          </StackPanel>
          <TabControl x:Name="DetailTabs">
            <TabItem Header="Properties">
              <ScrollViewer Margin="0,8,0,0">
                <StackPanel Spacing="14">
                  <ItemsControl ItemsSource="{Binding PropertyGroups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PropertyGroupViewModel">
                        <StackPanel Margin="0,0,0,14">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,4" />
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="mgmt:EntityProperty">
                                <Grid ColumnDefinitions="220,*" Margin="0,2">
                                  <TextBlock Text="{Binding Name}" Opacity="0.7" />
                                  <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Messages" IsVisible="{Binding HasMessages}">
              <views:MessagesView DataContext="{Binding Messages}" Margin="0,8,0,0" />
            </TabItem>
          </TabControl>
        </DockPanel>
      </Panel>
    </Grid>
  </DockPanel>
</UserControl>
