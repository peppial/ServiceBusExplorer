<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SbExplorer.App.ViewModels"
             xmlns:svc="using:SbExplorer.App.Services"
             x:Class="SbExplorer.App.Views.LogView"
             x:DataType="vm:MainWindowViewModel">
  <Border Classes="white" Margin="4">
    <ListBox x:Name="LogList" ItemsSource="{Binding Log.Entries}" SelectionMode="Multiple" Background="White"
             FontFamily="{StaticResource MonoFont}" FontSize="12">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="4,0" />
          <Setter Property="MinHeight" Value="16" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="svc:LogEntry">
          <TextBlock Text="{Binding Text}" Classes.error="{Binding IsError}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Copy All" Click="OnCopyAll" />
          <MenuItem Header="Copy Selected" Click="OnCopySelected" />
          <Separator />
          <MenuItem Header="Clear All" Command="{Binding ClearLogCommand}" />
          <MenuItem Header="Clear Selected" Click="OnClearSelected" />
          <Separator />
          <MenuItem Header="Save All" Command="{Binding SaveLogCommand}" />
        </ContextMenu>
      </ListBox.ContextMenu>
    </ListBox>
  </Border>
</UserControl>
