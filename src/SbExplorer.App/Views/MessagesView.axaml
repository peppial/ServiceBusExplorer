<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SbExplorer.App.ViewModels"
             x:Class="SbExplorer.App.Views.MessagesView"
             x:DataType="vm:MessagesViewModel">
  <!-- Messages / Deadletter tab: grid on top; message text and properties side by side below, like the original. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="notice" IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
    </Border>

    <ListBox DockPanel.Dock="Top" x:Name="SubQueueSelector" Classes="segmented" Margin="0,0,0,6"
             IsVisible="{Binding ShowSubQueues}"
             ItemsSource="{Binding SubQueues}" SelectedItem="{Binding SelectedSubQueue}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SubQueueOption">
          <TextBlock Text="{Binding Label}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <WrapPanel DockPanel.Dock="Top" ItemSpacing="6" LineSpacing="6" Margin="0,0,0,6">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="Top:" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding MaxMessages}" Minimum="1" Maximum="10000" Increment="10"
                       FormatString="0" Width="90" ParsingNumberStyle="Integer" />
        <TextBlock Text="From Seq:" VerticalAlignment="Center" />
        <TextBox Text="{Binding FromSequence}" Width="80" ToolTip.Tip="Peek starting at this sequence number (optional)" />
      </StackPanel>
      <Button Content="Peek" Command="{Binding PeekCommand}" />
      <Button Content="Peek Next" Command="{Binding PeekNextCommand}" />
      <Button Content="Receive" Command="{Binding ReceiveLockedCommand}"
              ToolTip.Tip="Receive and lock: complete, abandon, defer or dead-letter each message afterwards" />
      <Button Content="Receive and Delete" Command="{Binding ReceiveAndDeleteCommand}" />
      <Button Content="{Binding SendLabel}" Command="{Binding SendCommand}" />
      <Button Content="Stop" Command="{Binding PurgeCancelCommand}" IsVisible="{Binding PurgeCommand.IsRunning}" />
      <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" Opacity="0.7"
                 IsVisible="{Binding SelectionSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </WrapPanel>

    <Border DockPanel.Dock="Top" Classes="locked" IsVisible="{Binding HasLockedMessages}" Margin="0,0,0,6">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center">
          <TextBlock TextWrapping="Wrap">
            <Run Text="{Binding LockedCount}" FontWeight="SemiBold" />
            <Run Text="locked message(s); the first lock expires at" />
            <Run Text="{Binding LockedUntil}" FontWeight="SemiBold" />
          </TextBlock>
          <TextBlock Classes="hint" Text="{Binding LockWarning}" TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel Grid.Column="1" ItemSpacing="6">
          <Button Content="Complete" Command="{Binding CompleteCommand}" />
          <Button Content="Abandon" Command="{Binding AbandonCommand}" />
          <Button Content="Defer" Command="{Binding DeferCommand}" />
          <Button Content="Dead-letter" Command="{Binding DeadLetterCommand}" />
          <Button Content="Release All" Command="{Binding ReleaseCommand}" />
        </WrapPanel>
      </Grid>
    </Border>

    <TextBlock DockPanel.Dock="Top" x:Name="MessagesStatus" Text="{Binding Status}" Classes.error="{Binding HasError}"
               TextWrapping="Wrap" Margin="0,0,0,4"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Grid RowDefinitions="*,5,*" IsVisible="{Binding CanBrowse}">
      <Border Classes="white">
        <TableView x:Name="MessageTable" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}"
                   SelectionMode="Multiple" SelectionChanged="OnSelectionChanged" Background="White">
          <TableView.Columns>
            <TableViewColumn Header="MessageId" Binding="{Binding MessageId, x:DataType=vm:MessageRowViewModel}" Width="170" />
            <TableViewColumn Header="Sequence" Binding="{Binding SequenceNumber, x:DataType=vm:MessageRowViewModel}" Width="70" />
            <TableViewColumn Header="Size" Binding="{Binding Size, x:DataType=vm:MessageRowViewModel}" Width="64" />
            <TableViewColumn Header="Label" Binding="{Binding Subject, x:DataType=vm:MessageRowViewModel}" Width="130" />
            <TableViewColumn x:Name="DeadLetterReasonColumn" Header="DeadLetterReason" IsVisible="False"
                             Binding="{Binding DeadLetterReason, x:DataType=vm:MessageRowViewModel}" Width="160" />
            <TableViewColumn Header="SessionId" Binding="{Binding SessionId, x:DataType=vm:MessageRowViewModel}" Width="100" />
            <TableViewColumn Header="EnqueuedTimeUtc" Binding="{Binding Enqueued, x:DataType=vm:MessageRowViewModel}" Width="140" />
            <TableViewColumn Header="State" Binding="{Binding State, x:DataType=vm:MessageRowViewModel}" Width="72" />
            <TableViewColumn Header="DeliveryCount" Binding="{Binding DeliveryCount, x:DataType=vm:MessageRowViewModel}" Width="88" />
            <TableViewColumn Header="ContentType" Binding="{Binding ContentType, x:DataType=vm:MessageRowViewModel}" Width="130" />
          </TableView.Columns>
          <TableView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Repair and Resubmit Selected Message" Command="{Binding EditAndResubmitCommand}" IsVisible="{Binding IsDeadLetterView}" />
              <MenuItem Header="Resubmit Selected Messages In Batch Mode" Command="{Binding ResubmitCommand}" IsVisible="{Binding IsDeadLetterView}" />
              <MenuItem Header="Resubmit Selected Message" Command="{Binding ResendCommand}" />
              <MenuItem Header="Receive Selected Deferred Messages" Command="{Binding ReceiveDeferredCommand}" IsVisible="{Binding IsActiveView}" />
              <MenuItem Header="Cancel Selected Scheduled Message" Command="{Binding CancelScheduledCommand}" IsVisible="{Binding IsActiveView}" />
              <Separator />
              <MenuItem Header="Select All Messages" Click="OnSelectAll" />
              <MenuItem Header="Save Selected Message Text as File" Command="{Binding Detail.SaveBodyCommand, FallbackValue={x:Null}}" />
              <MenuItem Header="Copy Selected Message Text" Command="{Binding Detail.CopyBodyCommand, FallbackValue={x:Null}}" />
              <Separator />
              <MenuItem Header="Delete Selected Messages" Command="{Binding DeleteCommand}" IsVisible="{Binding IsDeadLetterView}" />
              <MenuItem Header="Purge" Command="{Binding PurgeCommand}" />
            </ContextMenu>
          </TableView.ContextMenu>
        </TableView>
      </Border>

      <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="Transparent" />

      <ContentControl Grid.Row="2" Content="{Binding Detail}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:MessageDetailViewModel">
            <Grid ColumnDefinitions="*,5,360">
              <HeaderedContentControl Classes="group" Header="Message Text">
                <DockPanel>
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                    <TextBlock Text="{Binding BodySummary}" Opacity="0.75" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                      <CheckBox Content="Hex" IsChecked="{Binding ShowHex}" IsVisible="{Binding CanToggleHex}" />
                      <Button Classes="small" Content="Copy" Command="{Binding CopyBodyCommand}" />
                      <Button Classes="small" Content="Save..." Command="{Binding SaveBodyCommand}" />
                    </StackPanel>
                  </Grid>
                  <TextBox x:Name="BodyBox" Text="{Binding BodyText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="NoWrap" FontFamily="{StaticResource MonoFont}" FontSize="12" MinHeight="80" />
                </DockPanel>
              </HeaderedContentControl>
              <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />
              <HeaderedContentControl Grid.Column="2" Classes="group" Header="Message Properties">
                <Border Classes="white">
                  <ScrollViewer>
                    <StackPanel>
                      <TextBlock Text="System Properties" FontWeight="SemiBold" Margin="6,2" />
                      <ItemsControl ItemsSource="{Binding SystemProperties}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PropertyRow">
                            <Grid ColumnDefinitions="150,*" Margin="10,1,6,1">
                              <TextBlock Text="{Binding Name}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                              <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="Custom Properties" FontWeight="SemiBold" Margin="6,6,6,2" />
                      <TextBlock Text="None" Opacity="0.6" Margin="10,0" IsVisible="{Binding !HasApplicationProperties}" />
                      <ItemsControl ItemsSource="{Binding ApplicationProperties}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PropertyRow">
                            <Grid ColumnDefinitions="150,*" Margin="10,1,6,1" ToolTip.Tip="{Binding Type}">
                              <TextBlock Text="{Binding Name}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                              <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </HeaderedContentControl>
            </Grid>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Grid>
  </DockPanel>
</UserControl>
