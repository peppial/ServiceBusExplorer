<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SbExplorer.App.ViewModels"
             x:Class="SbExplorer.App.Views.MessagesView"
             x:DataType="vm:MessagesViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="notice" IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
    </Border>

    <WrapPanel DockPanel.Dock="Top" ItemSpacing="6" LineSpacing="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="Max" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding MaxMessages}" Minimum="1" Maximum="5000" Increment="10"
                       FormatString="0" Width="110" ParsingNumberStyle="Integer" />
        <TextBox Text="{Binding FromSequence}" PlaceholderText="From seq #" Width="110"
                 ToolTip.Tip="Peek starting at this sequence number (optional)" />
      </StackPanel>
      <Button Content="Peek" Classes="accent" Command="{Binding PeekCommand}" />
      <Button Content="Peek next" Command="{Binding PeekNextCommand}" />
      <Button Content="Receive (lock)" Command="{Binding ReceiveLockedCommand}"
              ToolTip.Tip="Lock messages so you can complete, abandon, dead-letter or defer them" />
      <Button Content="Receive and delete…" Command="{Binding ReceiveAndDeleteCommand}" />
      <Button Content="{Binding SendLabel}" Command="{Binding SendCommand}" />
    </WrapPanel>

    <Border DockPanel.Dock="Top" Classes="locked" IsVisible="{Binding HasLockedMessages}" Margin="0,0,0,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
          <Run Text="{Binding LockedCount}" FontWeight="SemiBold" />
          <Run Text="locked message(s); the first lock expires at" />
          <Run Text="{Binding LockedUntil}" FontWeight="SemiBold" />
        </TextBlock>
        <WrapPanel Grid.Column="1" ItemSpacing="6">
          <Button Content="Complete" Command="{Binding CompleteCommand}" />
          <Button Content="Abandon" Command="{Binding AbandonCommand}" />
          <Button Content="Defer" Command="{Binding DeferCommand}" />
          <Button Content="Dead-letter…" Command="{Binding DeadLetterCommand}" />
          <Button Content="Release all" Command="{Binding ReleaseCommand}" />
        </WrapPanel>
      </Grid>
    </Border>

    <TextBlock DockPanel.Dock="Top" x:Name="MessagesStatus" Text="{Binding Status}" Classes.error="{Binding HasError}"
               TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Grid RowDefinitions="*,4,*" IsVisible="{Binding CanBrowse}">
      <TableView x:Name="MessageTable" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}">
        <TableView.Columns>
          <TableViewColumn Header="Seq #" Binding="{Binding SequenceNumber, x:DataType=vm:MessageRowViewModel}" Width="64" />
          <TableViewColumn Header="Message ID" Binding="{Binding MessageId, x:DataType=vm:MessageRowViewModel}" Width="150" />
          <TableViewColumn Header="Subject" Binding="{Binding Subject, x:DataType=vm:MessageRowViewModel}" Width="130" />
          <TableViewColumn Header="Session" Binding="{Binding SessionId, x:DataType=vm:MessageRowViewModel}" Width="110" />
          <TableViewColumn Header="Enqueued" Binding="{Binding Enqueued, x:DataType=vm:MessageRowViewModel}" Width="145" />
          <TableViewColumn Header="State" Binding="{Binding State, x:DataType=vm:MessageRowViewModel}" Width="78" />
          <TableViewColumn Header="Deliveries" Binding="{Binding DeliveryCount, x:DataType=vm:MessageRowViewModel}" Width="72" />
          <TableViewColumn Header="Size" Binding="{Binding Size, x:DataType=vm:MessageRowViewModel}" Width="66" />
          <TableViewColumn Header="Content type" Binding="{Binding ContentType, x:DataType=vm:MessageRowViewModel}" Width="140" />
          <TableViewColumn Header="Dead-letter reason" Binding="{Binding DeadLetterReason, x:DataType=vm:MessageRowViewModel}" Width="160" />
        </TableView.Columns>
      </TableView>

      <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="Transparent" />

      <ContentControl Grid.Row="2" Content="{Binding Detail}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:MessageDetailViewModel">
            <TabControl x:Name="DetailTabs">
              <TabItem Header="Body">
                <DockPanel>
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,4,0,6">
                    <TextBlock Text="{Binding BodySummary}" Opacity="0.7" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                      <CheckBox Content="Hex" IsChecked="{Binding ShowHex}" IsVisible="{Binding CanToggleHex}" />
                      <Button Content="Copy" Command="{Binding CopyBodyCommand}" />
                      <Button Content="Save…" Command="{Binding SaveBodyCommand}" />
                    </StackPanel>
                  </Grid>
                  <TextBox x:Name="BodyBox" Text="{Binding BodyText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="NoWrap" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                </DockPanel>
              </TabItem>
              <TabItem Header="Properties">
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding SystemProperties}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PropertyRow">
                        <Grid ColumnDefinitions="200,*" Margin="0,2">
                          <TextBlock Text="{Binding Name}" Opacity="0.7" />
                          <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Application properties">
                <Panel>
                  <TextBlock Text="No application properties." Opacity="0.6" Margin="0,8"
                             IsVisible="{Binding !HasApplicationProperties}" />
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding ApplicationProperties}" Margin="0,6,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PropertyRow">
                          <Grid ColumnDefinitions="200,*,90" Margin="0,2">
                            <TextBlock Text="{Binding Name}" Opacity="0.7" />
                            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2" Text="{Binding Type}" Opacity="0.5" FontSize="12" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Panel>
              </TabItem>
            </TabControl>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Grid>
  </DockPanel>
</UserControl>
