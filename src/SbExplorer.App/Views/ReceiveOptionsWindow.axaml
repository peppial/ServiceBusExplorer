<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SbExplorer.App.ViewModels"
        x:Class="SbExplorer.App.Views.ReceiveOptionsWindow"
        x:DataType="vm:ReceiveOptionsViewModel"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="14">
    <HeaderedContentControl Classes="group" Header="Receive Mode">
      <StackPanel Spacing="2">
        <RadioButton GroupName="mode" Content="Peek" IsChecked="{Binding IsPeek}" />
        <RadioButton GroupName="mode" Content="Receive and Delete" IsChecked="{Binding IsReceiveAndDelete}" IsEnabled="{Binding CanReceive}" />
        <RadioButton GroupName="mode" Content="Receive and Lock (complete, abandon, defer or dead-letter afterwards)"
                     IsChecked="{Binding IsReceiveLocked}" IsEnabled="{Binding CanReceive}" />
        <TextBlock Classes="error" Text="{Binding ModeWarning}" TextWrapping="Wrap" Margin="0,4,0,0"
                   IsVisible="{Binding ModeWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </HeaderedContentControl>
    <HeaderedContentControl Classes="group" Header="Messages">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <RadioButton GroupName="count" Content="Top" IsChecked="{Binding IsTop}" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding Count}" Minimum="1" Maximum="10000" FormatString="0" ParsingNumberStyle="Integer"
                         Width="110" IsEnabled="{Binding IsTop}" />
          <RadioButton GroupName="count" Content="{Binding AllLabel}" IsChecked="{Binding IsAll}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="From Sequence Number (peek):" Margin="0,4,0,0" />
        <TextBox x:Name="FromSequenceBox" Text="{Binding FromSequenceNumber}" PlaceholderText="From the oldest message" IsEnabled="{Binding IsPeek}" />
      </StackPanel>
    </HeaderedContentControl>
    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="OK" IsDefault="True" Click="OnOk" />
      <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
