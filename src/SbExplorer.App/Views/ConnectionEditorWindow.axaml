<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SbExplorer.App.ViewModels"
        x:Class="SbExplorer.App.Views.ConnectionEditorWindow"
        x:DataType="vm:ConnectionEditorViewModel"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="12">
    <StackPanel Spacing="4">
      <TextBlock Text="Name" />
      <TextBox x:Name="NameBox" Text="{Binding Name}" PlaceholderText="e.g. Orders (prod)" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="16">
      <RadioButton GroupName="auth" Content="Connection string" IsChecked="{Binding UseConnectionString}" />
      <RadioButton GroupName="auth" Content="Microsoft Entra ID" IsChecked="{Binding UseEntra}" />
    </StackPanel>

    <StackPanel Spacing="4" IsVisible="{Binding UseConnectionString}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Connection string" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <CheckBox Content="Show" IsChecked="{Binding RevealConnectionString}" />
          <Button Content="Use local emulator" Command="{Binding UseEmulatorCommand}" />
        </StackPanel>
      </Grid>
      <TextBox Text="{Binding ConnectionString}" PasswordChar="●"
               RevealPassword="{Binding RevealConnectionString}"
               PlaceholderText="Endpoint=sb://…;SharedAccessKeyName=…;SharedAccessKey=…" />
    </StackPanel>

    <StackPanel Spacing="10" IsVisible="{Binding UseEntra}">
      <StackPanel Spacing="4">
        <TextBlock Text="Namespace" />
        <TextBox Text="{Binding Namespace}" PlaceholderText="contoso.servicebus.windows.net" />
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Text="Sign in with" />
        <ComboBox ItemsSource="{Binding CredentialOptions}" SelectedItem="{Binding SelectedCredential}"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CredentialOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Text="Tenant ID (optional)" />
        <TextBox Text="{Binding TenantId}" PlaceholderText="Leave empty for your home tenant" />
      </StackPanel>
    </StackPanel>

    <TextBlock Text="{Binding ValidationError}" Classes="hint" TextWrapping="Wrap"
               IsVisible="{Binding !IsValid}" />
    <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap"
               Classes.success="{Binding TestSucceeded}"
               IsVisible="{Binding TestResult, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Test connection" Command="{Binding TestCommand}" />
        <Button Content="Cancel test" Command="{Binding TestCancelCommand}"
                IsVisible="{Binding TestCommand.IsRunning}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
        <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
        <Button Content="Save" Classes="accent" IsDefault="True" Command="{Binding SaveCommand}" />
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
