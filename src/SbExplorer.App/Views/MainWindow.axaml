<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SbExplorer.App.ViewModels"
        x:Class="SbExplorer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Service Bus Explorer"
        Width="1200" Height="780" MinWidth="800" MinHeight="500">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="8,4">
      <TextBlock x:Name="StatusText" Text="{Binding Status}" />
    </Border>
    <Grid ColumnDefinitions="300,4,*">
      <Border Grid.Column="0" Padding="8">
        <TextBlock Text="Connections" FontWeight="SemiBold" />
      </Border>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
      <Border Grid.Column="2" Padding="8">
        <TextBlock Text="Connect to a namespace to get started." Opacity="0.7"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Grid>
  </DockPanel>
</Window>
