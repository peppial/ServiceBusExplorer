<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SbExplorer.App.ViewModels"
        xmlns:views="using:SbExplorer.App.Views"
        x:Class="SbExplorer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/icon.png"
        Width="1460" Height="920" MinWidth="900" MinHeight="560">
  <DockPanel>
    <Menu DockPanel.Dock="Top" x:Name="MainMenu">
      <MenuItem Header="_File">
        <MenuItem Header="_Connect" Command="{Binding ConnectCommand}" InputGesture="{OnPlatform Default='Ctrl+N', macOS='Cmd+N'}" />
        <MenuItem x:Name="SavedConnectionsMenu" Header="_Saved connections" IsEnabled="{Binding HasSavedConnections}" />
        <MenuItem Header="_Disconnect" Command="{Binding DisconnectCommand}" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Clear Log" Command="{Binding ClearLogCommand}" />
        <MenuItem Header="Copy Log" Command="{Binding CopyLogCommand}" />
        <MenuItem Header="Save Log As..." Command="{Binding SaveLogCommand}" />
      </MenuItem>
      <MenuItem Header="_Actions" IsEnabled="{Binding IsConnected}">
        <MenuItem Header="Create Queue" Command="{Binding Explorer.NewQueueCommand, FallbackValue={x:Null}}" />
        <MenuItem Header="Create Topic" Command="{Binding Explorer.NewTopicCommand, FallbackValue={x:Null}}" />
        <MenuItem Header="Create Subscription" Command="{Binding Explorer.NewSubscriptionCommand, FallbackValue={x:Null}}" />
        <MenuItem Header="Add Rule" Command="{Binding Explorer.NewRuleCommand, FallbackValue={x:Null}}" />
        <Separator />
        <MenuItem Header="Refresh Entities" Command="{Binding Explorer.RefreshCommand, FallbackValue={x:Null}}" InputGesture="F5" />
        <MenuItem Header="Export Entities" Command="{Binding Explorer.ExportCommand, FallbackValue={x:Null}}" />
        <MenuItem Header="Import Entities" Command="{Binding Explorer.ImportCommand, FallbackValue={x:Null}}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Set Default Layout" Click="OnSetDefaultLayout" />
        <MenuItem Header="_Log Window" ToggleType="CheckBox" IsChecked="{Binding IsLogVisible}" Command="{Binding ToggleLogCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About Service Bus Explorer" Command="{Binding AboutCommand}" />
      </MenuItem>
    </Menu>

    <Grid x:Name="Layout" RowDefinitions="*,5,190" Margin="6,2,6,6">
      <Grid ColumnDefinitions="380,5,*">
        <HeaderedContentControl Classes="panel" Header="Service Bus Namespace">
          <Panel>
            <views:EntityTreeView x:Name="TreePanel" DataContext="{Binding Explorer}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsConnected}" />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="8" VerticalAlignment="Top" IsVisible="{Binding IsConnecting}">
              <TextBlock Text="Connecting…" VerticalAlignment="Center" />
              <Button Content="Cancel" Classes="small" Command="{Binding CancelConnectCommand}" />
            </StackPanel>
          </Panel>
        </HeaderedContentControl>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

        <HeaderedContentControl Grid.Column="2" Classes="panel" x:Name="DetailsPanel"
                                Header="{Binding Explorer.DetailsTitle, FallbackValue='Service Bus Explorer'}">
          <views:EntityDetailsView DataContext="{Binding Explorer}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsConnected}" />
        </HeaderedContentControl>
      </Grid>

      <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="Transparent" IsVisible="{Binding IsLogVisible}" />

      <HeaderedContentControl Grid.Row="2" Classes="panel log" Header="Log" IsVisible="{Binding IsLogVisible}">
        <views:LogView x:Name="LogPanel" />
      </HeaderedContentControl>
    </Grid>
  </DockPanel>
</Window>
