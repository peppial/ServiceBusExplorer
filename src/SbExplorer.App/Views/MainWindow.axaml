<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SbExplorer.App.ViewModels"
        xmlns:views="using:SbExplorer.App.Views"
        x:Class="SbExplorer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Service Bus Explorer"
        Width="1360" Height="820" MinWidth="900" MinHeight="500">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="10,6"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                   Classes.error="{Binding HasError}" ToolTip.Tip="{Binding Status}" />
        <Button Grid.Column="1" Content="Cancel" Padding="8,0" Margin="8,0,0,0"
                IsVisible="{Binding ConnectCommand.IsRunning}"
                Command="{Binding ConnectCancelCommand}" />
      </Grid>
    </Border>
    <Grid ColumnDefinitions="260,4,*">
      <DockPanel Grid.Column="0" Margin="10">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Text="Connections" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="+ Add" Command="{Binding AddCommand}"
                  ToolTip.Tip="Add a connection" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" IsVisible="{Binding SecretsAreInsecure}" TextWrapping="Wrap"
                   Margin="0,0,0,8" FontSize="12" Opacity="0.8"
                   Text="No system keychain found. Connection strings are stored encrypted with a local key file." />
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" ItemSpacing="6" LineSpacing="6">
          <Button Content="Connect" Command="{Binding ConnectCommand}" Classes="accent" />
          <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
          <Button Content="Edit" Command="{Binding EditCommand}" />
          <Button Content="Delete" Command="{Binding DeleteCommand}" />
        </WrapPanel>
        <Panel>
          <ListBox x:Name="ConnectionList" ItemsSource="{Binding Connections}"
                   SelectedItem="{Binding SelectedConnection}" DoubleTapped="OnConnectionDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ConnectionItemViewModel">
                <Grid ColumnDefinitions="Auto,*">
                  <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                           Fill="#2EA043" IsVisible="{Binding IsConnected}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Host}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AuthLabel}" FontSize="11" Opacity="0.55" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="No saved connections yet. Click + Add." Opacity="0.6" TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding !Connections.Count}" />
        </Panel>
      </DockPanel>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
      <Panel Grid.Column="2" Margin="10">
        <TextBlock Text="Connect to a namespace to get started." Opacity="0.7"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !IsConnected}" />
        <views:ExplorerView x:Name="Explorer" DataContext="{Binding Explorer}"
                            IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsConnected, FallbackValue=False}" />
      </Panel>
    </Grid>
  </DockPanel>
</Window>
