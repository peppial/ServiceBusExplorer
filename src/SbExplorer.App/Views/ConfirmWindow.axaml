<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SbExplorer.App.Views.ConfirmWindow"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="16">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" IsDefault="True" Click="OnCancel" />
      <Button x:Name="ConfirmButton" Classes="danger" Click="OnConfirm" />
    </StackPanel>
  </StackPanel>
</Window>
