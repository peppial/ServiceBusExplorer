<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SbExplorer.App.ViewModels"
             xmlns:views="using:SbExplorer.App.Views"
             x:Class="SbExplorer.App.Views.EntityDetailsView"
             x:DataType="vm:ExplorerViewModel">
  <Panel Margin="8">
    <TextBlock Text="Select a queue, topic, subscription or rule in the tree." Opacity="0.6"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding !ShowsDetails}" />

    <!-- "Create Queue", "Create Subscription", … -->
    <DockPanel IsVisible="{Binding IsCreating}" Background="{StaticResource WindowBrush}">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button x:Name="CreateButton" Content="Create" Command="{Binding CommitCreateCommand}" />
        <Button Content="Cancel" Command="{Binding CancelCreateCommand}" />
      </StackPanel>
      <ScrollViewer>
        <views:EntityFormView DataContext="{Binding Creating}" />
      </ScrollViewer>
    </DockPanel>

    <ContentControl Content="{Binding Details}" IsVisible="{Binding ShowsDetails}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:EntityPanelViewModel">
          <views:EntityPanelView />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Panel>
</UserControl>
