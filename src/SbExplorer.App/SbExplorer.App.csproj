<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SbExplorer.App</RootNamespace>
    <AssemblyName>ServiceBusExplorer</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SbExplorer.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The .ico and .icns are packaging assets; only the PNG is loaded at runtime. -->
    <AvaloniaResource Include="Assets\icon.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SbExplorer.Core\SbExplorer.Core.csproj" />
    <ProjectReference Include="..\SbExplorer.Infrastructure\SbExplorer.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
</Project>
